---
import ProductSearch from "../components/ProductSearch";

type Product = {
  id: number;
  title: string;
  category: string;
  price: number;
  thumbnail: string;
};

const res = await fetch("https://dummyjson.com/products?limit=4");
const data: { products: Product[] } = await res.json();
const products = data.products;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro + React + TypeScript Demo</title>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        font-family: system-ui, sans-serif;
        margin: 0;
        background: #f6f7fb;
        color: #1f2937;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
      }
      section {
        margin-top: 2rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
      }
      .card {
        background: white;
        border-radius: 16px;
        padding: 1rem;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
      }
      .badge {
        display: inline-block;
        background: #e0f2fe;
        color: #0369a1;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        font-size: 0.8rem;
        margin-bottom: 0.75rem;
      }
      img {
        width: 100%;
        height: 160px;
        object-fit: contain;
      }
      code {
        background: #eef2ff;
        padding: 0.15rem 0.35rem;
        border-radius: 6px;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Astro Store</h1>
      <p>
        Demo de <strong>Astro + React + TypeScript</strong> consumiendo
        <strong>DummyJSON</strong>.
      </p>

      <section>
        <h2>Los más vendidos</h2>
        <p>
          Estos productos fueron obtenidos en el servidor con <code>fetch</code>
          desde Astro.
        </p>

        <div class="grid">
          {products.map((product) => (
            <a href={`/products/${product.id}`} class="card">
              <img src={product.thumbnail} alt={product.title} />
              <span class="badge">{product.category}</span>
              <h3>{product.title}</h3>
              <p>${product.price}</p>
            </a>
          ))}
        </div>
      </section>

      <section>
        <h2>2) React con consumo cliente</h2>
        <p>
          Este componente hace <code>fetch</code> en el navegador y permite
          buscar y filtrar.
        </p>

        <ProductSearch client:load />
      </section>
    </main>
  </body>
</html>